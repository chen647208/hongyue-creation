{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/main",
    "rootDir": "..",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "**/*.ts",
    "../types/**/*.d.ts",
    "../shared/types.ts",
    "../shared/sandbox.ts",
    "../shared/quickjs.ts",
    "../shared/sql/**/*.ts",
    "../shared/constants/**/*.ts",
    "../shared/i18n/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
