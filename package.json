{
  "name": "hongyue-creation",
  "private": true,
  "version": "1.0.0",
  "description": "本地优先的 AI 小说创作助手：书籍管理、灵感生成、人物构建、大纲设计、章节规划、知识库与正文写作。",
  "author": "Hongyue",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/chen647208/hongyue-creation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen647208/hongyue-creation.git"
  },
  "keywords": [
    "electron",
    "ai",
    "novel",
    "writing",
    "local-first",
    "小说",
    "创作"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "build/main/main/main.js",
  "lint-staged": {
    "*.{ts,tsx}": "eslint"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "node scripts/sync-docs.mjs && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5199 && electron .\"",
    "build:electron": "npm run build:electron:main && npm run build:electron:preload",
    "build:electron:main": "tsc -p src/main/tsconfig.json",
    "build:electron:preload": "esbuild src/main/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=build/main/preload/preload.js",
    "electron:build": "npm run build && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:main": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/main/tsconfig.preload.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:main",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "types:escapes": "node scripts/check-type-escapes.mjs",
    "lint:dead": "knip --include files,dependencies,devDependencies,unlisted,binaries",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "bench": "node scripts/bench-db.mjs",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix && node scripts/add-license-headers.mjs",
    "headers": "node scripts/add-license-headers.mjs",
    "headers:check": "node scripts/add-license-headers.mjs --check",
    "licenses:generate": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "sbom": "node scripts/sbom.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "cross-env VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:e2e:packaged": "playwright test -c playwright.packaged.config.ts",
    "check:icons": "node scripts/check-win-icon.cjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "preverify": "npm ci --dry-run --no-audit --no-fund --loglevel=error",
    "prepare": "husky",
    "verify": "npm run lint && npm run typecheck:all && npm run deps:check && npm run types:escapes && npm run lint:dead && npm run test:coverage && npm run headers:check && npm run licenses:check && npm run scan:secrets && npm run electron:build && npm run bundle:check",
    "dist": "npm run electron:build && electron-builder",
    "dist:win": "npm run electron:build && electron-builder --win",
    "dist:mac": "npm run electron:build && electron-builder --mac",
    "dist:linux": "npm run electron:build && electron-builder --linux",
    "wasm:build": "node scripts/build-wasm-examples.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@google/genai": "^1.34.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.12",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9",
    "fountain-js": "^1.2.4",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.0",
    "quickjs-emscripten": "^0.32.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.10.2",
    "unpdf": "^1.8.1",
    "vectra": "^0.15.0",
    "ws": "^8.21.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.40.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "wabt": "^1.0.39",
    "wait-on": "^9.0.3"
  }
}
